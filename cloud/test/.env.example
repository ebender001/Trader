# Copy this file to test/.env and fill in the same values you have set
# as environment variables on Back4App (Dashboard > App Settings >
# Server Settings > Environment Variables). Never commit the real .env.

ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_PAPER_KEY_ID=your_paper_key_id
ALPACA_PAPER_SECRET_KEY=your_paper_secret_key
TRADING_MODE=paper
